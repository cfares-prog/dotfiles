# vim:fileencoding=utf-8:foldmethod=marker

# BEGIN_KITTY_THEME
# Atelier Cave Dark
include current-theme.conf
# END_KITTY_THEME


# BEGIN_KITTY_FONTS
font_family      family="IosevkaTermFontMono"
font_size        20
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS

enable_audio_bell no
cursor_shape block
shell_integration no-cursor
# cursor #c1c1c1
